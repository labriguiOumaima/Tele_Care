	"item": [
		{
			"name": "1 - Protocoles (Direct 8082)",
			"item": [
				{
					"name": "1.1 - Créer un nouveau protocole",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Protocole créé avec succès\", function () {",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(jsonData.type).to.eql(\"FUITE_DE_GAZ\");",
									"    pm.expect(jsonData.niveauPriorite).to.eql(5);",
									"});",
									"pm.collectionVariables.set(\"createdProtocolId\", jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"FUITE_DE_GAZ\",\n    \"etapes\": \"1. Évacuer le logement immédiatement. 2. Couper l'arrivée générale si accessible sans danger. 3. Appeler les pompiers (18) et Gaz de France. 4. Prévenir le contact d'urgence.\",\n    \"niveauPriorite\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/protocols",
							"host": ["{{baseUrl}}"],
							"path": ["api", "protocols"]
						}
					}
				},
				{
					"name": "1.2 - Consulter tous les protocoles",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Liste de protocoles non vide\", function () {",
									"    pm.expect(jsonData).to.be.an('array');",
									"    pm.expect(jsonData.length).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/protocols",
							"host": ["{{baseUrl}}"],
							"path": ["api", "protocols"]
						}
					}
				},
