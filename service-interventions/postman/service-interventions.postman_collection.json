{
  "info": {
    "name": "Tele-Care - service-interventions (jalon v1.0)",
    "description": "Collection Postman de la Personne 3 : CRUD et cycle de vie AFFECTEE > SUR_PLACE > CLOTUREE. Lancer le service sur le port 8083 puis executer avec le Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Cas valides (cycle complet)",
      "item": [
        {
          "name": "1.1 Liste vide au depart (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/interventions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interventions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Reponse = tableau\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Creer une intervention (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/interventions/new",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interventions",
                "new"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alertId\": {{alertId}},\n  \"assistantNom\": \"Karim Benali\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"alertId\", Math.floor(Math.random() * 900000) + 100000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set(\"interventionId\", j.id);",
                  "pm.test(\"statut = AFFECTEE\", function () { pm.expect(j.statut).to.eql(\"AFFECTEE\"); });",
                  "pm.test(\"Header Location present\", function () { pm.response.to.have.header(\"Location\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Consulter par id (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/interventions/{{interventionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interventions",
                "{{interventionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"alertId conserve\", function () { pm.expect(pm.response.json().alertId).to.eql(pm.collectionVariables.get(\"alertId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Enregistrer l'arrivee (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/interventions/{{interventionId}}/arrivee",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interventions",
                "{{interventionId}}",
                "arrivee"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"statut = SUR_PLACE\", function () { pm.expect(j.statut).to.eql(\"SUR_PLACE\"); });",
                  "pm.test(\"heureArrivee renseignee\", function () { pm.expect(j.heureArrivee).to.not.be.null; });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Rediger le compte-rendu (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/interventions/{{interventionId}}/compte-rendu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interventions",
                "{{interventionId}}",
                "compte-rendu"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"compteRendu\": \"Personne retrouvee consciente, constantes normales. Contact prevenu.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"compteRendu enregistre\", function () { pm.expect(pm.response.json().compteRendu).to.include(\"consciente\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Cloturer l'intervention (PUT)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/interventions/{{interventionId}}/cloture",
