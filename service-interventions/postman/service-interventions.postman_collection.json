          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"statut = CLOTUREE\", function () { pm.expect(pm.response.json().statut).to.eql(\"CLOTUREE\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Filtrer par statut CLOTUREE (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/interventions?statut=CLOTUREE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interventions"
              ],
              "query": [
                {
                  "key": "statut",
                  "value": "CLOTUREE"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Au moins une intervention CLOTUREE\", function () { pm.expect(pm.response.json().length).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
