{
  "info": {
    "name": "TeleCare - parcours de validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pile lancee avec le script. Runner : delai 1500 ms recommande pour les messages Kafka. Les scenarios de panne/restart et SMTP sont automatises par scripts/telecare.py. La derniere partie supprime les donnees de ce parcours."
  },
  "variable": [
    {
      "key": "usersUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "benefUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "alertsUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "interventionsUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin123"
    }
  ],
  "item": [
    {
      "name": "01 Initialiser et creer un assistant",
      "request": {
        "method": "POST",
        "url": "{{usersUrl}}/api/utilisateurs",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{runId}}-user"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Assistant test\",\n  \"email\": \"assistant.{{runId}}@example.test\",\n  \"role\": \"ASSISTANT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code === 201) pm.collectionVariables.set(\"assistantId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
